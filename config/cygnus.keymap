#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

#define COMBO_TERM_FAST 45
#define COMBO_TERM_SLOW 55
#define COMBO_PRIOR_IDLE 135

#define QUICK_TAP_MS 175
#include "zmk-helpers/key-labels/36.h"
#include "zmk-helpers/helper.h"

/* Homerow mods */
/* use helper macros to define left and right hand keys */
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // left-hand keys
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // right-hand keys
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // thumb keys

/* left-hand HRMs */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;                // repeat on tap-into-hold
    require-prior-idle-ms = <200>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;             // delay positional check until key-release
)

/* right-hand HRMs */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;                // repeat on tap-into-hold
    require-prior-idle-ms = <180>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;             // delay positional check until key-release
)

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        at: alpha_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <8 9>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        ctrl_backspace {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <28 29>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <14 15>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <20 29>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        sticky_gui {
            bindings = <&sk LGUI>;
            key-positions = <12 17>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        sticky_alt {
            bindings = <&sk LALT>;
            key-positions = <11 18>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        sticky_ctrl {
            bindings = <&sk LCTRL>;
            key-positions = <10 19>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        qwerty_toggle {
            bindings = <&tog 1>;
            key-positions = <3 4 5 6>;
        };

        btconfig {
            bindings = <&mo 8>;
            key-positions = <5 6 7 8>;
        };

        leftpar {
            bindings = <&kp LPAR>;
            key-positions = <23 24>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        leftbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <13 14>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        leftbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 4>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        rightpar {
            bindings = <&kp RPAR>;
            key-positions = <25 26>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        rightbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <15 16>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        rightbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <5 6>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        lessthan {
            bindings = <&kp LESS_THAN>;
            key-positions = <22 23>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        greaterthan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <26 27>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        macro {
            bindings = <&macro1>;
            key-positions = <7 8 9>;
            layers = <2>;
        };

        macro2 {
            bindings = <&macro2>;
            key-positions = <17 18 19>;
            layers = <2>;
        };

        macro3 {
            bindings = <&macro3>;
            key-positions = <27 28 29>;
            layers = <2>;
        };
        macro4 {
            bindings = <&macro4>;
            key-positions = <26 27 28 29>;
            layers = <2>;
        };
    };

    macros {
        macro1: macro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp E &kp S &kp T &kp RET>;
            label = "MACRO1";
        };

        macro2: macro2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp E &kp S &kp T &kp RET>;
            label = "MACRO2";
        };

        macro3: macro3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp E &kp S &kp T &kp RET>;
            label = "MACRO3";
        };
        macro4: macro4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp E &kp S &kp T &kp RET>;
            label = "MACRO4";
        };

    };

    keymap {
        compatible = "zmk,keymap";

        colemak-dh {
            bindings = <
  &kp Q         &kp W        &kp F        &kp P          &kp B          &kp J         &kp L            &kp U           &kp Y        &kp SLASH
  &hml LCTRL A  &hml LALT R  &hml LGUI S  &hml LSHIFT T  &kp G          &kp M         &hmr LSHIFT N    &hmr LGUI E     &hmr LALT I  &hmr LCTRL O
  &kp X         &kp C        &kp D        &kp V          &at 2 Z        &at 6 K       &at 5 H          &kp COMMA       &kp DOT      &kp DELETE
                             &kp LSHIFT   &kp SPACE      &lt 7 ENTER    &lt 4 ESC     &lt 3 BACKSPACE  &kp LCTRL

            >;
        };

        qwerty {
            label = "qwerty";
            bindings = <
  &kp Q         &kp W        &kp E         &kp R          &kp T          &kp Y         &kp U               &kp I          &kp O          &kp P
  &hml LCTRL A  &hml LALT S  &hml LGUI D   &hml LSHIFT F  &kp G          &kp H         &hmr LSHIFT J       &hmr LGUI K    &hmr LALT L    &hmr LCTRL SLASH
  &kp Z         &kp X        &kp C         &kp V          &at 2 B        &at 6 N       &at 5 M             &kp COMMA      &kp DOT        &kp DELETE
                             &kp LSHIFT    &kp SPACE      &lt 7 ENTER    &lt 4 ESC     &lt 3 BACKSPACE     &kp LCTRL
            >;
        };

        num+fn {
            label = "num+fn";
            bindings = <
  &kp F1  &kp F2   &kp F3    &kp F4     &none         &kp N0      &kp N1         &kp N2    &kp N3    &kp SLASH
  &kp F5  &kp F6   &kp F7    &kp F8     &none         &kp MINUS   &kp N4         &kp N5    &kp N6    &kp ASTRK
  &kp F9  &kp F10  &kp F11   &kp F12    &none         &kp PLUS    &kp N7         &kp N8    &kp N9    &kp EQUAL
                   &kp LEFT  &kp RIGHT  &kp DELETE    &kp PERIOD  &kp BACKSPACE  &kp HASH
            >;
        };

        symbol {
            label = "symbol";
            bindings = <
  &kp DOLLAR  &kp PERCENT  &kp CARET  &none      &none        &kp EQUAL  &none           &kp GRAVE  &kp SINGLE_QUOTE   &kp SEMICOLON
  &kp AMPS    &kp EXCL     &kp QMARK  &none      &none        &kp MINUS  &kp UNDERSCORE  &kp SQT    &kp DOUBLE_QUOTES  &kp COLON
  &kp AT      &kp HASH     &none      &none      &none        &kp PLUS   &kp ASTERISK    &kp TILDE  &kp PIPE           &kp BACKSLASH
                           &trans     &trans     &kp SPACE    &trans     &trans          &trans
            >;
        };

        nav {
            label = "nav";
            bindings = <
  &kp LS(TAB)  &kp TAB   &none     &kp INSERT  &kp HOME           &kp PAGE_UP    &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(UP)  &kp LA(RIGHT)
  &kp LCTRL    &kp LALT  &kp LGUI  &kp LSHIFT  &kp END            &kp PAGE_DOWN  &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT
  &none        &none     &none     &none       &kp PRINTSCREEN    &kp DELETE     &kp LC(LEFT)  &kp LC(DOWN)  &kp LC(UP)  &kp LC(RIGHT)
                         &trans    &trans      &kp SPACE          &trans         &trans        &trans
            >;
        };

        workspace-nav {
            label = "ws-nav";
            bindings = <
  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &none       &none    &none  &none  &none  &none  &none
  &kp LG(N4)  &kp LG(N5)  &kp LG(N6)  &none       &none    &none  &none  &none  &none  &none
  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)  &none    &none  &none  &none  &none  &none
                          &none       &none       &none    &none  &none  &none
            >;
        };

        workspace-mv {
            label = "ws-mv";
            bindings = <
  &kp LG(LS(N1))  &kp LG(LS(N2))  &kp LS(LG(N3))  &none           &none    &none  &none  &none  &none  &none
  &kp LG(LS(N4))  &kp LG(LS(N5))  &kp LG(LS(N6))  &none           &none    &none  &none  &none  &none  &none
  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))  &kp LS(LG(N0))  &none    &none  &none  &none  &none  &none
                                  &none           &none           &none    &none  &none  &none
            >;
        };

        mouse {
            label = "mouse";
            bindings = <
  &none  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP      &none  &mkp MB4  &mkp MB5  &none     &none
  &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &none  &mkp MB1  &mkp MB2  &mkp MB3  &none
  &none  &none           &none           &none            &none             &none  &none     &none     &none     &none
                         &none           &none            &none             &none  &none     &none
            >;
        };

        bt+boot {
            label = "bt+boot";
            bindings = <
  &bt BT_SEL 0  &none  &none         &none       &bt BT_CLR      &none  &none  &none  &none  &bootloader
  &bt BT_SEL 1  &none  &none         &none       &none           &none  &none  &none  &none  &none
  &bt BT_SEL 2  &none  &none         &none       &none           &none  &none  &none  &none  &none
                       &out OUT_TOG  &bt BT_PRV  &bt BT_NXT      &none  &none  &none
            >;
        };
    };
};

